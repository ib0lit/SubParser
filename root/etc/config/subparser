config subparser 'settings'
	option override_fp 'as_is'
	option enabled '0'
	option interval 'never'
	option custom_hour '3'
	option custom_minute '0'
	option ping_threshold '350'
	option max_jitter '150'
	option max_best_nodes '0'
	option filter_ru '1'
	option per_section_config '0'
	option update_mode 'replace'
	list target_section 'main'
	option sec_mode_main 'replace'
	option tg_bot_token ''
	option tg_chat_id ''

config subscription
	option enabled '1'
	option name 'Моя подписка'
	option url ''
	option user_agent 'v2rayN'