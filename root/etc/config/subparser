config subparser 'settings'
	option override_fp 'as_is'
	option enabled '0'
	option interval 'never'
	option custom_hour '3'
	option custom_minute '0'
	option ping_threshold '350'
	option max_jitter '150'
	option max_best_nodes '0'
	option filter_ru '1'
	option per_section_config '0'
	option update_mode 'replace'
	list target_section 'main'
	option sec_mode_main 'replace'
	option allow_insecure_tls '0'
	option allow_local_diag '0'
	option allow_unstable_fallback '0'
	option stress_top '40'
	option hysteresis_pct '10'
	option update_branch 'main'
	option speedtest_proxy 'socks5h://127.0.0.1:4534'
	option tg_bot_token ''
	option tg_chat_id ''
	option watchdog_enabled '1'
	option watchdog_interval '5'
	option watchdog_sub_limits '1'
	option watchdog_wan_check '1'
	option watchdog_down_wait '10'
	option watchdog_restart_wait '15'
	option watchdog_young_sec '35'
	option watchdog_cooldown '45'
	option watchdog_http_timeout '8'
	option watchdog_test_timeout '4000'
	option watchdog_group_timeout '3000'
	option watchdog_group_retry '3'
	option watchdog_max_run '600'
	option watchdog_test_url 'https://www.gstatic.com/generate_204'
	option watchdog_restart_podkop '1'
	option watchdog_emergency '1'
	option watchdog_notify_recovery '1'

config subscription
	option enabled '1'
	option name 'Моя подписка'
