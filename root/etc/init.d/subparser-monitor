#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

start_service() {
    local enabled svc_enabled
    enabled=$(uci -q get subparser.settings.enabled)
    svc_enabled=$(uci -q get subparser.settings.watchdog_service_enabled)

    [ "$enabled" = "1" ] || return 0
    [ "$svc_enabled" = "1" ] || return 0

    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /usr/bin/subparser-service-monitor.py
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "subparser"
}
