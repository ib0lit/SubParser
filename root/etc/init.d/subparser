#!/bin/sh /etc/rc.common

START=95
STOP=10

CRON_TMP="/tmp/cron_subparser.tmp"
# Watchdog запускается раз в минуту всегда, пока включён сам сервис:
# фактическую частоту задаёт настройка watchdog_interval внутри скрипта,
# поэтому её изменение не требует перезаписи crontab.
WATCHDOG_CRON="* * * * * /usr/bin/subparser-watchdog.sh >/dev/null 2>&1"

get_cron_schedule() {
    local interval="$1"
    local ch="$2"
    local cm="$3"

    [ -z "$ch" ] && ch="0"
    [ -z "$cm" ] && cm="0"

    # Срезаем лидирующие нули для безопасного сравнения в Busybox sh
    ch="${ch#0}"; [ -z "$ch" ] && ch="0"
    cm="${cm#0}"; [ -z "$cm" ] && cm="0"

    case "$interval" in
        never|"")
            echo ""
            ;;
        1h)
            echo "0 * * * *"
            ;;
        12h)
            echo "0 */12 * * *"
            ;;
        24h)
            echo "0 0 * * *"
            ;;
        custom_daily)
            echo "${cm} ${ch} * * *"
            ;;
        custom_every_h)
            [ "$ch" -lt 1 ] && ch="1"
            echo "${cm} */${ch} * * *"
            ;;
        *)
            echo ""
            ;;
    esac
}

write_crontab() {
    local enabled="$1"
    local interval="$2"
    local ch="$3"
    local cm="$4"

    crontab -l 2>/dev/null | grep -v "subparser.py" | grep -v "subparser-helper.sh bg_sync" \
        | grep -v "subparser-watchdog.sh" > "$CRON_TMP" || true

    if [ "$enabled" = "1" ]; then
        # Watchdog работает всегда, когда служба включена: он сам проверяет
        # настройки и не трогает Podkop при выключенном сервисе.
        echo "$WATCHDOG_CRON" >> "$CRON_TMP"

        if [ "$interval" != "never" ]; then
            local sched
            sched=$(get_cron_schedule "$interval" "$ch" "$cm")
            if [ -n "$sched" ]; then
                echo "$sched SUBPARSER_TRIGGER=cron /usr/bin/python3 /usr/bin/subparser.py >/dev/null 2>&1" >> "$CRON_TMP"
            fi
        fi
    fi

    crontab "$CRON_TMP" 2>/dev/null || true
    rm -f "$CRON_TMP"
    /etc/init.d/cron restart >/dev/null 2>&1 || true
}

start() {
    local enabled interval custom_hour custom_minute

    config_load subparser
    config_get enabled settings enabled '0'
    config_get interval settings interval 'never'
    config_get custom_hour settings custom_hour '0'
    config_get custom_minute settings custom_minute '0'

    write_crontab "$enabled" "$interval" "$custom_hour" "$custom_minute"
}

stop() {
    write_crontab "0" "never" "0" "0"
}

restart() {
    stop
    start
}
